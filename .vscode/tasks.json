{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "OpenOCD + JLink",
            "type": "shell",
            "group": "none",
            "dependsOn": [
                "make"
            ],
            "command": "openocd -f interface/jlink.cfg -c 'transport select jtag' -f target/stm32f1x.cfg",
            "problemMatcher": []
        }
    ]
}