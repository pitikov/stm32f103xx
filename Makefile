# Данный файл по сути является настроечным файлом проекта.
# Установив значения переменных он передает управление сборкой файлу project.mk

# Определение имени проекта - влияет только на имя форируемой прошивки
PROJECT_NAME		:= stm32f103xx

# Размер FLASH RAM микроконтроллера
FLASH_SIZE			:= 64K
# Размер ROM (ОЗУ) микроконтроллера
RAM_SIZE			:= 20K

# Выделяемый размер кучи (динамическое выделение памяти через malloc и new)
HEAP_SIZE			:= 1024
# Выделяемый размер стека
STACK_SIZE			:= 1024

# Отладочный режим сборки: true или false
DEBUG_BUILD			?= true

# Частота HSE осцилятора (Стандарт 8 MHz) Если используем другой - поправь
HSE_VALUE			:= 8000000

# Частота LSE осцилятора (Стандарт 32.768 KHZ) Если используем другой - поправь
LSE_VALUE			:= 32768

PERFOMANCE_LINE		:= MIDDLE_DENSITY

# Подлючаем файл правил сборки проекта
include project.mk